# Local development. NEVER put secrets here; use Secret Manager / a local
# untracked .env.secret for CATALOG_API_KEY, POSTGRES_DSN and REDIS_PASSWORD.

SERVICE_NAME="scaffold-api"
HOST="localhost"
PORT="8080"
SHUTDOWN_TIMEOUT="10"
LOG_JSON="false"
REQUEST_TIMEOUT="10s"
GIN_MODE="debug"
API_TIME_ZONE="Asia/Bangkok"

# Bearer tokens. `make dev-auth` writes the local keypair; `make token` signs one.
AUTH_JWT_PUBLIC_KEY_FILE=".auth/dev.pub"
AUTH_JWT_ISSUER="scaffold-dev"
AUTH_JWT_AUDIENCE="scaffold-api"

# Widget business settings (fmt templates)
WIDGET_PRODUCT_DATA_SRC="/common-api/v2/widgets/%s/products?type=%s"
WIDGET_PROMOTION_TYPE="PROMOTION"
WIDGET_CATEGORY_DATA_SRC="/common-api/v1/widgets/%s/categories"

# Datasources. Empty -> in-process memory stand-ins. To run against
# `make up`'s containers from the host instead:
#   POSTGRES_DSN="postgres://scaffold:scaffold@localhost:5432/scaffold?sslmode=disable"
#   REDIS_ADDR="localhost:6379"
POSTGRES_DSN=""
POSTGRES_MAX_CONNS="10"
REDIS_ADDR=""
REDIS_DB="0"
WIDGET_CACHE_TTL="5m"

# External catalog API. Empty base URL -> every product list is accepted.
CATALOG_BASE_URL=""
CATALOG_TIMEOUT="3s"
