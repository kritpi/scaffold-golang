{
  "SERVICE_NAME": "scaffold-api",
  "PORT": "8080",
  "SHUTDOWN_TIMEOUT": "30",
  "LOG_JSON": "true",
  "REQUEST_TIMEOUT": "10s",
  "GIN_MODE": "release",
  "API_TIME_ZONE": "Asia/Bangkok",
  "AUTH_JWT_PUBLIC_KEY_FILE": "/run/secrets/jwt.pub",
