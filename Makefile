.PHONY: dev-auth token run test cover vet lint lint-layout lint-config secrets swag tidy check up down reset migrate-up migrate-down migrate-down-all migrate-new ddl ddl-check

MIGRATE_IMAGE := migrate/migrate:v4.19.1
MIGRATIONS    := db/postgres/migrations
COMPOSE_DSN   := postgres://scaffold:scaffold@postgres:5432/scaffold?sslmode=disable

AUTH_DIR := .auth

dev-auth: $(AUTH_DIR)/dev.pub

$(AUTH_DIR)/dev.pub:
	go run ./cmd/devtoken keygen $(AUTH_DIR)

token: dev-auth
	@set -a && . ./configs/local.env && set +a && go run ./cmd/devtoken sign -key $(AUTH_DIR)/dev.key \
	  -iss "$$AUTH_JWT_ISSUER" -aud "$$AUTH_JWT_AUDIENCE" -email $(or $(EMAIL),ops@example.com)

run: dev-auth
	set -a && . ./configs/local.env && set +a && go run ./cmd/server

test:
	go test -race -timeout 2m ./...

cover:
	go test -coverprofile=coverage.out ./internal/core/service/... && go tool cover -func=coverage.out | tail -1

vet:
	go vet ./...

lint:
	golangci-lint run ./...

swag:
	swag init -g cmd/server/main.go -o docs/openapi --parseInternal

tidy:
	go mod tidy

lint-layout:
	python3 -I scripts/check_layout.py .

lint-config:
	python3 -I scripts/check_config.py

secrets:
	docker run --rm -v "$(CURDIR)":/repo ghcr.io/gitleaks/gitleaks:v8.28.0 dir /repo --no-banner --redact

check: tidy vet lint-layout lint-config test

up: dev-auth
	docker compose up -d --build

down:
	docker compose down

reset:
	docker compose down -v

migrate-up:
	docker compose run --rm migrate

migrate-down:
	docker compose run --rm migrate -path=/migrations -database "$(COMPOSE_DSN)" down $(or $(N),1)

migrate-down-all:
	docker compose run --rm migrate -path=/migrations -database "$(COMPOSE_DSN)" down -all

migrate-new:
	$(if $(NAME),,$(error NAME is required, e.g. make migrate-new NAME=add_widget_tags))
	docker run --rm -v $(CURDIR)/$(MIGRATIONS):/migrations $(MIGRATE_IMAGE) \
	  create -ext sql -dir /migrations -seq -digits 6 $(NAME)

ddl:
	@{ echo '-- Generated by `make ddl` from db/postgres/migrations. Do not edit.'; echo; \
	docker compose exec -T postgres pg_dump -U scaffold -d scaffold \
	  --schema-only --no-owner --no-privileges --exclude-table=schema_migrations \
	  | grep -v -e '^--' -e '^SET ' -e '^SELECT pg_catalog' -e '^\\restrict' -e '^\\unrestrict' \
	  | cat -s; } > db/postgres/ddl/schema.sql

ddl-check: ddl
	git diff --exit-code db/postgres/ddl/schema.sql
